# 开发环境配置
# .env.development

# 应用端口
VITE_PORT = 3000

# API 基础路径：开发环境走 Vite 代理，避免浏览器跨域预检
VITE_API_BASE_URL = /api

# 后端服务地址
VITE_API_PROXY_TARGET = http://localhost:8100/nurti

# TAC 验证码静态资源路径（指向 public/tac 目录）
VITE_TAC_STATIC_URL = /tac

# TAC 验证码接口地址
VITE_CAPTCHA_GENERATE_URL = /api/auth/captcha/generate
VITE_CAPTCHA_CHECK_URL = /api/auth/captcha/verify

# 应用标题
VITE_APP_TITLE = 智能营养管理系统
